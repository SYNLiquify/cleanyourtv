<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings panel's drop shadow (activity_quick_settings.xml), drawn because the system's elevation shadow does
     not show in that see-through window on some TVs. Generated: rounded rectangles stacked towards the panel, each
     13% black, so it is darkest at the panel's edge and fades out; it reaches further below than above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="38dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="36dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="3dp" android:right="4dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item android:left="7dp" android:top="5dp" android:right="7dp" android:bottom="11dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item android:left="9dp" android:top="6dp" android:right="9dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="30dp" />
