<?xml version="1.0" encoding="utf-8"?>
<!-- This fork: the Dim screen tile made compact, half width like the others: the icon, then the name over a short bar
     and the level. OK starts adjusting it (activated: the blue ring), Left/Right change it, OK or Back ends it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="46dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:background="@drawable/quick_tile_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_dim"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:duplicateParentState="true">

            <FrameLayout
                android:id="@+id/dimTrack"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@drawable/quick_dim_track"
                android:duplicateParentState="true">

                <View
                    android:id="@+id/dimFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/quick_dim_fill"
                    android:duplicateParentState="true" />
            </FrameLayout>

            <TextView
                android:id="@+id/dimValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="10sp"
                android:fontFamily="@string/font_medium"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
