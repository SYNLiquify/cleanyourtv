<?xml version="1.0" encoding="utf-8"?>
<!-- Quick settings opened by the remote's Settings button, laid out like Google TV's: the date and time with a round
     button for the TV's settings, then the other settings as two columns of tiles. The glass of the Inputs dropdown,
     top right over Home or any app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The drop shadow, drawn here (quick_shadow): the system's elevation shadow does not show in this see-through
         window on some TVs (a Hisense on Android 11). Its padding is the shadow's reach, deeper below the panel. -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/quick_shadow"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

    <LinearLayout
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/quickDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium" />

                <TextClock
                    android:id="@+id/quickTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="-0.01" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:id="@+id/quickAll"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/quick_round_bg"
                    android:focusable="true"
                    android:clickable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        android:tint="@drawable/pill_text"
                        android:duplicateParentState="true"
                        android:contentDescription="@string/tv_settings" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/tv_settings"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@string/font_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Two tiles a row, filled by QuickSettingsActivity. -->
        <LinearLayout
            android:id="@+id/tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
