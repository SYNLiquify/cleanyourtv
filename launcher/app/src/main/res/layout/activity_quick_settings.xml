<?xml version="1.0" encoding="utf-8"?>
<!-- Quick settings opened by the remote's Settings button, laid out like Google TV's: the date and time with a round
     button for the TV's settings, then the other settings as two columns of tiles. The glass of the Inputs dropdown,
     top right over Home or any app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The drop shadow (SoftShadow, set in QuickSettingsActivity): the system's elevation shadow does not show in
         this see-through window on some TVs (a Hisense on Android 11). The padding is room for its blur to fade out,
         deeper below the panel. -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="24dp"
        android:paddingBottom="52dp">

    <include layout="@layout/quick_panel" />
    </FrameLayout>
</FrameLayout>
