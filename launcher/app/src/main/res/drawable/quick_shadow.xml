    </item>
    <item android:left="11dp" android:top="8dp" android:right="11dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="13dp" android:top="9dp" android:right="13dp" android:bottom="21dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
