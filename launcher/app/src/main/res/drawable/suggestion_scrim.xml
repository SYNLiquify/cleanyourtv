<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens a Nuvio suggestion's backdrop (nuvio_suggestion.xml) towards the left, where the clock and the title sit,
     and towards the bottom, where the dock is, so both stay readable; the rest of the picture stays bright. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#CC000000" android:centerColor="#4D000000"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#E6000000" android:centerColor="#33000000"
                android:centerY="0.3" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
