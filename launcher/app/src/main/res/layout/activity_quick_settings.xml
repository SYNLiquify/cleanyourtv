<?xml version="1.0" encoding="utf-8"?>
<!-- Quick settings opened by the remote's Settings button, laid out like Google TV's: the date and time with a round
     button for the TV's settings, then the other settings as two columns of tiles. The glass of the Inputs dropdown,
     top right over Home or any app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/quickDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@string/font_medium" />

                <TextClock
                    android:id="@+id/quickTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="-0.01" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:id="@+id/quickAll"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/quick_round_bg"
                    android:focusable="true"
                    android:clickable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        android:tint="@drawable/pill_text"
                        android:duplicateParentState="true"
                        android:contentDescription="@string/tv_settings" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/tv_settings"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Two tiles a row, filled by QuickSettingsActivity. -->
        <LinearLayout
            android:id="@+id/tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
